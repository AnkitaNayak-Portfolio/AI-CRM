# Server Configuration
PORT=5000
NODE_ENV=development

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:password@localhost:5432/crm_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/crm_db?schema=public"

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Redis (Optional: falls back to in-memory queue if unavailable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# AI & APIs
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

